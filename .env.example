# Database
# Leave blank to use SQLite by default, or provide a postgres connection string
# DATABASE_URL=postgresql://admin:password@localhost:5432/data_monitor

# Supabase Storage Configuration
S3_BUCKET_NAME=data-pipeline-bucket
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Email Alerting Settings
SMTP_EMAIL=your_email@gmail.com
# For Gmail, you MUST use an App Password, not your regular password
SMTP_APP_PASSWORD=your_app_password
ALERT_RECIPIENT=alert_recipient@example.com
