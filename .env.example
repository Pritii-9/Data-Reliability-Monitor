# =============================================================================
#  Validata — Data Validation Engine
#  Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git — it is already in .gitignore.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# AWS / S3  (Storage Layer)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Log in to https://console.aws.amazon.com
#   2. Go to IAM > Users > Your User > Security Credentials
#   3. Create Access Key → copy Access Key ID and Secret Access Key
#   4. S3_BUCKET_NAME: the bucket you created (e.g. validata-datalake-priti)
#   5. AWS_REGION: the region where the bucket was created (e.g. us-east-1)

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=validata-datalake

# S3 folder paths — DO NOT create these manually in the AWS console.
# S3 folders are virtual (just path prefixes). They are created automatically
# the first time Spark writes a file to that path. You only need the bucket itself.
#
# Your bucket structure will look like this after the pipeline runs:
#   s3://validata-datalake/
#     raw/legacy_system/          <-- upload your CSVs here manually
#     raw/new_system/             <-- upload your CSVs here manually
#     staging/legacy_system/      <-- created by NB01
#     staging/new_system/         <-- created by NB01
#     staging/validated/          <-- created by NB03
#     curated/validation_results/ <-- created by NB04
#     curated/audit_reports/      <-- created by NB06
#     data/quarantine/            <-- created by NB02/NB03 when bad rows found
#     logs/                       <-- created by every notebook
S3_RAW_LEGACY=raw/legacy_system/
S3_RAW_NEW=raw/new_system/
S3_STAGING_LEGACY=staging/legacy_system/
S3_STAGING_NEW=staging/new_system/
S3_STAGING_VALIDATED_LEGACY=staging/validated/legacy_system/
S3_STAGING_VALIDATED_NEW=staging/validated/new_system/
S3_CURATED=curated/validation_results/
S3_QUARANTINE=data/quarantine/
S3_LOGS=logs/
S3_REPORTS=curated/audit_reports/


# ─────────────────────────────────────────────────────────────────────────────
# SNOWFLAKE  (Data Warehouse Layer)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Log in to https://app.snowflake.com
#   2. SF_ACCOUNT: bottom-left corner > click your name > Account Identifier
#      Format: orgname-accountname  e.g.  myorg-xy12345
#   3. SF_USER: the username you log in with (or create a service account)
#   4. SF_PASSWORD: your Snowflake password
#   5. SF_WAREHOUSE: the virtual warehouse to use (default: COMPUTE_WH)
#   6. SF_ROLE: SYSADMIN works for setup; create a dedicated role in production

SF_ACCOUNT=myorg-xy12345
SF_USER=VALIDATA_SVC_USER
SF_PASSWORD=YourSnowflakePassword123!
SF_DATABASE=ValiData_DB
SF_WAREHOUSE=COMPUTE_WH
SF_ROLE=SYSADMIN

# Snowflake schema names (must match your Snowflake DDL setup)
SF_SCHEMA_RAW=RAW_SCHEMA
SF_SCHEMA_STAGING=STAGING_SCHEMA
SF_SCHEMA_CURATED=CURATED_SCHEMA

# Snowflake table names
SF_TABLE_LEGACY=LEGACY_TRANSACTIONS
SF_TABLE_NEW=NEW_SYSTEM_TRANSACTIONS
SF_TABLE_RESULTS=VALIDATION_RESULTS
SF_TABLE_AUDIT=AUDIT_LOG


# ─────────────────────────────────────────────────────────────────────────────
# DATABRICKS  (Compute / ETL Layer)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Log in to https://accounts.azuredatabricks.net (or your cloud URL)
#   2. DATABRICKS_HOST: Settings > Developer > Access Tokens > copy workspace URL
#      Format: https://<workspace-id>.azuredatabricks.net
#   3. DATABRICKS_TOKEN: Settings > Developer > Access Tokens > Generate New Token
#   4. DATABRICKS_CLUSTER_ID: Compute > click your cluster > copy ID from URL
#      Format: 0824-123456-abc12345

DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_token_here
DATABRICKS_CLUSTER_ID=0824-123456-abc12345

# Databricks secret scope name (used in NB05 + NB06 for Snowflake credentials)
# Create with: databricks secrets create-scope --scope validata-secrets
DATABRICKS_SECRET_SCOPE=validata-secrets


# ─────────────────────────────────────────────────────────────────────────────
# SNOWFLAKE CORTEX  (AI Explanation Layer — Notebook 06)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET:
#   Cortex runs INSIDE Snowflake — no separate API key needed.
#   Just confirm your Snowflake account has Cortex enabled:
#     SELECT SNOWFLAKE.CORTEX.COMPLETE('mistral-7b', 'hello') AS test;
#   If it returns text, Cortex is active on your account.
#   If you get an error, raise a support ticket with Snowflake to enable it.
#
#   Supported regions (as of 2026): AWS us-east-1, us-west-2, eu-west-1
#   CORTEX_MODEL options: mistral-7b | llama3-8b | llama3-70b | mixtral-8x7b

CORTEX_MODEL=mistral-7b
CORTEX_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL ALERTING  (Optional — pipeline failure notifications)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET (Gmail):
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-character code as SMTP_APP_PASSWORD (not your real password)

SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=abcd efgh ijkl mnop
ALERT_RECIPIENT=your_alert_email@example.com


# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE GEMINI API  (Optional — local AI fallback if Cortex unavailable)
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO GET:
#   1. Go to https://aistudio.google.com
#   2. Click "Get API Key" > Create API Key
#   3. Copy and paste below

GEMINI_API_KEY=AIzaSyABCDEFGHIJKLMNOPQRSTUVWXYZ-example


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DATABASE  (FastAPI dashboard backend — existing feature)
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (default, no setup needed).
# Uncomment and fill in for PostgreSQL:
# DATABASE_URL=postgresql://admin:password@localhost:5432/validata_monitor

DATABASE_URL=


# ─────────────────────────────────────────────────────────────────────────────
# PIPELINE BEHAVIOUR FLAGS  (optional tuning)
# ─────────────────────────────────────────────────────────────────────────────

# Amount tolerance for mismatch detection (0.001 = 0.1%, 0.0 = exact match)
AMOUNT_TOLERANCE_PCT=0.001

# Migration date window for date validation
MIGRATION_DATE_MIN=2026-01-01
MIGRATION_DATE_MAX=2026-12-31

# Max transaction amount before a WARN flag is raised
AMOUNT_MAX=10000000

# Set to true to enable verbose Spark logging in notebooks
SPARK_VERBOSE_LOGGING=false
